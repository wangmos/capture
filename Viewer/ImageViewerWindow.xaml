<Window x:Class="WeCapture.Viewer.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:WeCapture.Viewer"
        Title="WeCapture" Height="760" Width="900"
        MinWidth="720" MinHeight="440"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" FontFamily="{StaticResource UiFont}">

    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>

        <!-- 图标按钮：与截图工具条同一套观感 -->
        <Style x:Key="VwIcon" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#28FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VwToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#28FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SmallPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource ShellBorder}" Margin="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Height="44" MouseLeftButtonDown="OnTitleBarDrag">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="截图" Style="{StaticResource WindowTitle}"/>
                    <TextBlock x:Name="SizeText" Style="{StaticResource HintText}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource CloseButton}" Click="OnClose"
                        HorizontalAlignment="Right" Margin="0,0,8,0" ToolTip="关闭 (Esc)"/>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{StaticResource BorderSubtleBrush}"/>

            <!-- 视图控制 -->
            <Grid Grid.Row="2" Margin="14,10,14,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="－" Style="{StaticResource SmallButton}" Click="OnZoomOut" ToolTip="缩小 (Ctrl+-)"/>
                    <TextBlock x:Name="ZoomText" Style="{StaticResource HintText}" Width="52"
                               TextAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                    <Button Content="＋" Style="{StaticResource SmallButton}" Click="OnZoomIn" ToolTip="放大 (Ctrl++)"/>
                    <Button Content="适应窗口" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Click="OnFitWindow" ToolTip="整图适应窗口 (0)"/>
                    <Button Content="适应宽度" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Click="OnFitWidth" ToolTip="适应宽度 (W)"/>
                    <Button Content="1:1" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Click="OnActualSize" ToolTip="原始尺寸 (1)"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OcrVisibleButton" Content="识别可见区域" Style="{StaticResource SmallButton}"
                            Click="OnOcrVisible" ToolTip="只识别当前显示的部分"/>
                    <Button x:Name="OcrAllButton" Content="全文识别" Style="{StaticResource SmallButton}"
                            Margin="6,0,0,0" Click="OnOcrAll" ToolTip="识别整张图片"/>
                </StackPanel>
            </Grid>

            <!-- 图像视口 -->
            <Border Grid.Row="3" Background="#FF101012" Margin="14,10,14,0" CornerRadius="8"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" ClipToBounds="True">
                <ScrollViewer x:Name="Scroller"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="OnWheel" Background="Transparent">
                    <Grid x:Name="ImageHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Background="Transparent"
                          MouseLeftButtonDown="OnImageDown"
                          MouseMove="OnImageMove"
                          MouseLeftButtonUp="OnImageUp">
                        <!-- Stretch 必须 Uniform：None 时设 Width/Height 只撑大布局，位图不缩放 -->
                        <Image x:Name="Img" Stretch="Uniform" SnapsToDevicePixels="True"/>
                        <v:ViewerAnnotationLayer x:Name="Layer" IsHitTestVisible="False"/>
                        <Canvas x:Name="EditCanvas">
                            <TextBox x:Name="TextEdit" Visibility="Hidden"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     FontFamily="Microsoft YaHei" AcceptsReturn="False" MinWidth="40"/>
                        </Canvas>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- 功能按钮：与截图时保持一致 -->
            <Grid Grid.Row="4" Margin="14,10,14,14">
                <StackPanel x:Name="ToolsRow" Orientation="Horizontal"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PinButton" Content="钉住" Style="{StaticResource SmallButton}" Click="OnPin"/>
                    <Button x:Name="SaveButton" Content="保存" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Click="OnSave"/>
                    <Button x:Name="CopyButton" Content="复制" Style="{StaticResource SmallPrimaryButton}" Margin="6,0,0,0" Click="OnCopy"/>
                </StackPanel>
            </Grid>

            <!-- 边缘缩放热区（无边框窗口没有原生调整边框）。
                 注意不要给这层 Grid 设 Background：否则它会吃掉整个窗口的鼠标事件 -->
            <Grid Grid.RowSpan="5">
                <Rectangle Height="6" VerticalAlignment="Top" Fill="Transparent" Cursor="SizeNS"
                           MouseLeftButtonDown="OnResizeTop"/>
                <Rectangle Height="6" VerticalAlignment="Bottom" Fill="Transparent" Cursor="SizeNS"
                           MouseLeftButtonDown="OnResizeBottom"/>
                <Rectangle Width="6" HorizontalAlignment="Left" Fill="Transparent" Cursor="SizeWE"
                           MouseLeftButtonDown="OnResizeLeft"/>
                <Rectangle Width="6" HorizontalAlignment="Right" Fill="Transparent" Cursor="SizeWE"
                           MouseLeftButtonDown="OnResizeRight"/>
                <Rectangle Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Fill="Transparent" Cursor="SizeNWSE" MouseLeftButtonDown="OnResizeBottomRight"/>
                <Rectangle Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                           Fill="Transparent" Cursor="SizeNESW" MouseLeftButtonDown="OnResizeBottomLeft"/>
            </Grid>
        </Grid>
    </Border>
</Window>
