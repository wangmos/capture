<Window x:Class="WeCapture.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WeCapture.Settings"
        Title="WeCapture 设置" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource UiFont}">

    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
    </Window.Resources>

    <Border Style="{StaticResource ShellBorder}" Margin="14">
        <StackPanel>

            <!-- 标题栏（自绘：可拖动 + 关闭） -->
            <Grid Height="44" MouseLeftButtonDown="OnTitleBarDrag">
                <TextBlock Text="设置" Style="{StaticResource WindowTitle}" Margin="18,0,0,0"/>
                <Button Style="{StaticResource CloseButton}" Click="OnCancel"
                        HorizontalAlignment="Right" Margin="0,0,8,0" ToolTip="关闭"/>
            </Grid>

            <Border Height="1" Background="{StaticResource BorderSubtleBrush}"/>

            <StackPanel Margin="18,18,18,0">

                <!-- 截图热键 -->
                <TextBlock Text="截图热键" Style="{StaticResource SectionLabel}"/>
                <local:HotkeyBox x:Name="HotkeyBox" Margin="0,8,0,0"
                                 Style="{StaticResource ModernTextBox}"/>
                <TextBlock Text="点击输入框后按下新的组合键，Esc 取消。热键被其他程序占用时会保留原设置。"
                           Style="{StaticResource HintText}" Margin="0,7,0,0"/>

                <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,18,0,0"/>

                <!-- 行为 -->
                <TextBlock Text="行为" Style="{StaticResource SectionLabel}" Margin="0,18,0,0"/>

                <CheckBox x:Name="AutoTextSelectBox" Style="{StaticResource ModernCheckBox}"
                          Content="框选后自动识别文字" Margin="0,12,0,0"/>
                <TextBlock Text="截图完成即在后台识别，可直接用鼠标在图上拖选文字复制。关闭后仍可点工具条上的 I 图标手动进入。"
                           Style="{StaticResource HintText}" Margin="28,5,0,0"/>

                <CheckBox x:Name="AutoStartBox" Style="{StaticResource ModernCheckBox}"
                          Content="开机自动启动" Margin="0,14,0,0"/>
                <TextBlock Text="登录后常驻托盘，随时用热键截图。"
                           Style="{StaticResource HintText}" Margin="28,5,0,0"/>

                <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,18,0,0"/>

                <!-- 快捷键 -->
                <Grid Margin="0,18,0,0">
                    <TextBlock Text="快捷键" Style="{StaticResource SectionLabel}"/>
                    <Button x:Name="ResetShortcutsButton" Content="恢复默认"
                            Style="{StaticResource SecondaryButton}" Height="26" MinWidth="72"
                            FontSize="12" HorizontalAlignment="Right" Click="OnResetShortcuts"/>
                </Grid>
                <TextBlock Text="点击右侧方框后按下新组合键；Delete 清除绑定，Esc 取消录制。组合键被占用时会自动解除原来的绑定。"
                           Style="{StaticResource HintText}" Margin="0,7,0,0"/>

                <Border Margin="0,10,0,0" CornerRadius="8" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                    <ScrollViewer x:Name="ShortcutScroller" MaxHeight="228"
                                  VerticalScrollBarVisibility="Auto" Padding="4,6">
                        <StackPanel x:Name="ShortcutList"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- 底部操作 -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="0,0,9,9" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,14">
                    <Button Content="取消" Style="{StaticResource SecondaryButton}" Click="OnCancel"/>
                    <Button x:Name="OkButton" Content="保存" Style="{StaticResource PrimaryButton}"
                            Margin="10,0,0,0" IsDefault="True" Click="OnOk"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</Window>
