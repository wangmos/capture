<Window x:Class="WeCapture.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WeCapture.Settings"
        Title="WeCapture 设置" Width="450" Height="300"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <StackPanel Margin="24,20,24,18">
        <TextBlock Text="截图热键" FontWeight="SemiBold"/>
        <local:HotkeyBox x:Name="HotkeyBox" Margin="0,8,0,0" Padding="6,5"
                         ToolTip="点击后按下新组合键，Esc 取消"/>
        <CheckBox x:Name="AutoStartBox" Content="开机自动启动" Margin="0,16,0,0"/>
        <CheckBox x:Name="AutoTextSelectBox" Content="框选后自动识别文字（可直接在图上选字复制）"
                  Margin="0,12,0,0"
                  ToolTip="关闭后仍可点工具条上的 I 图标手动进入取字"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
            <Button x:Name="OkButton" Content="确定" Width="84" Padding="0,6" IsDefault="True" Click="OnOk"/>
            <Button Content="取消" Width="84" Padding="0,6" Margin="10,0,0,0" IsCancel="True" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
