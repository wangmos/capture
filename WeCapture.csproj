<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 不要写成 net10.0-windows10.0.19041.0：那会引入 WinRT 投影
         （Microsoft.Windows.SDK.NET.dll，约 24MB），而本项目自从移除
         Windows.Media.Ocr 兜底后已不使用任何 WinRT API。 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WeCapture</RootNamespace>
    <AssemblyName>WeCapture</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- 限定 win-x64：否则 Microsoft.ML.OnnxRuntime 会把 Android/Apple/Linux 的原生库
         全部拷进输出（多出约 250MB）。输出目录保持不带 RID 后缀，测试脚本路径不变。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- 发布版不带调试符号 -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
    <Product>WeCapture</Product>
    <Description>微信截图风格工具</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms 仅用于托盘/屏幕 API，去掉隐式全局 using 避免与 WPF 类型冲突 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- PP-OCRv6 small 模型随程序分发 -->
    <None Include="Models\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
