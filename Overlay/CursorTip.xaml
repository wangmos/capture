<UserControl x:Class="WeCapture.Overlay.CursorTip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Border Background="#E6000000" CornerRadius="3" Padding="6,3">
        <StackPanel>
            <TextBlock x:Name="PosText" Foreground="White" FontSize="12" FontFamily="Segoe UI, Microsoft YaHei"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <Border x:Name="Swatch" Width="11" Height="11" CornerRadius="1"
                        BorderBrush="#66FFFFFF" BorderThickness="1" Background="Black"/>
                <TextBlock x:Name="ColorText" Foreground="White" FontSize="12" Margin="5,0,0,0"
                           FontFamily="Consolas" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
