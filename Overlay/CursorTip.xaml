<UserControl x:Class="WeCapture.Overlay.CursorTip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Border Style="{StaticResource TipBorder}">
        <StackPanel>
            <TextBlock x:Name="PosText" Style="{StaticResource TipText}"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Border x:Name="Swatch" Width="12" Height="12" CornerRadius="3"
                        BorderBrush="#59FFFFFF" BorderThickness="1" Background="Black"
                        VerticalAlignment="Center"/>
                <TextBlock x:Name="ColorText" Style="{StaticResource TipText}"
                           Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
