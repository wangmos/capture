<Window x:Class="WeCapture.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WeCapture.Overlay"
        xmlns:tb="clr-namespace:WeCapture.Toolbar"
        WindowStyle="None" AllowsTransparency="False" Background="Black"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Focusable="True" ShowActivated="False"
        PreviewMouseLeftButtonDown="OnPreviewLeftDown"
        PreviewMouseLeftButtonUp="OnPreviewLeftUp"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewMouseRightButtonDown="OnPreviewRightDown"
        PreviewKeyDown="OnPreviewKeyDown">
    <!-- AllowsTransparency 保持 False。开启它会把窗口切到 WPF 的分层窗口路径（软件合成），
         而这是个全屏覆盖层、拖拽时每帧整屏重绘。这里也根本不需要窗口透明：
         冻结截图 BgImage 铺满整屏且不透明，遮罩是画上去的半透明矩形。
         实测（3440x1440）：不透明时 Show() 约 101~114ms，改成透明后升到 160ms。 -->
    <Grid>
        <!-- 冻结的屏幕截图（1:1 铺满本屏） -->
        <Image x:Name="BgImage" Stretch="Fill"/>

        <!-- 遮罩/选区/标注自绘层 -->
        <local:AnnotationLayer x:Name="Layer"/>

        <Canvas>
            <!-- 坐标 + 取色提示 -->
            <local:CursorTip x:Name="CursorTip" Visibility="Hidden"/>
            <!-- 宽×高尺寸提示 -->
            <local:SizeTip x:Name="SizeTip" Visibility="Hidden"/>
            <!-- 浮动工具条 -->
            <tb:ToolbarControl x:Name="Toolbar" Visibility="Collapsed"/>
            <!-- 文字编辑框 -->
            <TextBox x:Name="TextEdit" Visibility="Hidden"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     FontFamily="Microsoft YaHei" AcceptsReturn="False"
                     MinWidth="40"/>
        </Canvas>
    </Grid>
</Window>
