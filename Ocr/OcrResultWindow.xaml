<Window x:Class="WeCapture.Ocr.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="识别结果 - WeCapture" Height="480" Width="560"
        WindowStartupLocation="CenterScreen" Background="#FF252526"
        ShowInTaskbar="True" Topmost="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="ResultText" Grid.Row="0"
                 IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Background="#FF1E1E1E" Foreground="#FFE8E8E8"
                 BorderBrush="#FF3F3F46" BorderThickness="1"
                 FontSize="14" FontFamily="Microsoft YaHei"
                 Padding="8"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CopyButton" Content="复制全部" Width="90" Height="30" Margin="0,0,10,0"
                    Click="OnCopy" Cursor="Hand"
                    Background="#FF0078D4" Foreground="White" BorderThickness="0"/>
            <Button Content="关闭" Width="80" Height="30"
                    Click="OnClose" Cursor="Hand"
                    Background="#FF3F3F46" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
