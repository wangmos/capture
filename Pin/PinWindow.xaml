<Window x:Class="WeCapture.Pin.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="OnDragStart"
        PreviewKeyDown="OnKeyDown"
        MouseRightButtonDown="OnCloseClick">
    <Border BorderBrush="#CC1E90FF" BorderThickness="1" x:Name="Root">
        <Grid>
            <Image x:Name="Img" Stretch="None"/>
            <Button x:Name="CloseBtn" Width="22" Height="22"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,4,4,0" Visibility="Hidden"
                    Click="OnCloseClick" Cursor="Hand"
                    ToolTip="关闭钉住">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#CC000000" CornerRadius="3">
                            <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="White" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="16" Height="16"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
    <Window.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CloseBtn"
                                                   Storyboard.TargetProperty="(UIElement.Visibility)">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Visible}"/>
                    </ObjectAnimationUsingKeyFrames>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CloseBtn"
                                                   Storyboard.TargetProperty="(UIElement.Visibility)">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.4" Value="{x:Static Visibility.Hidden}"/>
                    </ObjectAnimationUsingKeyFrames>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
